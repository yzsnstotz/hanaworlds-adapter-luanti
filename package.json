{
  "name": "hanaworlds-adapter-luanti",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HanaWorlds local-world world-adapter/v6; current connection and Canvas-only transaction transport",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-adapter-luanti.git"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "imports": {
    "#contracts": "./vendor/hanaworlds-contracts/dist/local/index.mjs"
  },
  "files": [
    "src/index.mjs",
    "src/version.mjs",
    "src/local-worlds.mjs",
    "src/local-world-port.mjs",
    "src/local-runtime.mjs",
    "src/local-transactions.mjs",
    "src/local-records.mjs",
    "src/local-courier.mjs",
    "src/native-storage.mjs",
    "src/material-sources.mjs",
    "payload/hanaworlds_adapter/mod.conf",
    "payload/hanaworlds_adapter/init.lua",
    "payload/hanaworlds_adapter/engine.lua",
    "payload/hanaworlds_adapter/transport.lua",
    "payload/hanaworlds_adapter/region.lua",
    "payload/hanaworlds_adapter/facts.lua",
    "cordis.patch.yml",
    "GADGET.md",
    "LICENSE_AUDIT.md",
    "NOTICE",
    "vendor/hanaworlds-contracts",
    "!vendor/hanaworlds-contracts/fixtures",
    "DEFERRED-LOCAL-WORLD.md",
    "vendor/hanaworlds-contracts.manifest.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/version.mjs && node --check src/local-worlds.mjs && node --check src/local-world-port.mjs && node --check src/local-runtime.mjs && node --check src/local-transactions.mjs && node --check src/local-records.mjs && node --check src/local-courier.mjs && node --check src/native-storage.mjs && node --check src/material-sources.mjs && luac -p payload/hanaworlds_adapter/init.lua payload/hanaworlds_adapter/engine.lua payload/hanaworlds_adapter/transport.lua payload/hanaworlds_adapter/region.lua payload/hanaworlds_adapter/facts.lua",
    "test": "node --test test/local-world-current.test.mjs test/local-world-v6.test.mjs",
    "test:lua": "lua test/local-world-region.lua",
    "verify:contracts": "node scripts/verify-contracts-pin.mjs",
    "verify:contracts:source": "node scripts/verify-contracts-pin.mjs --source",
    "vendor:contracts": "node scripts/vendor-contracts.mjs",
    "test:catalogue": "node --test test/local-catalogue.test.mjs",
    "test:materials": "node --test test/local-material-facts.test.mjs test/local-material-sources.test.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0"
  }
}
