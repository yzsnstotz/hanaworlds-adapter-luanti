{
  "name": "hanaworlds-adapter-luanti",
  "version": "0.14.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HanaWorlds local-world world-adapter/v6; current connection and Canvas-only transaction transport",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-adapter-luanti.git"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./host": {
      "types": "./src/host.d.ts",
      "import": "./src/host.mjs"
    },
    "./inspection-context": {
      "types": "./src/inspection-context.d.ts",
      "import": "./src/inspection-context.mjs"
    }
  },
  "imports": {
    "#contracts": "hanaworlds-contracts"
  },
  "files": [
    "src/index.mjs",
    "src/version.mjs",
    "src/local-worlds.mjs",
    "src/local-world-port.mjs",
    "src/local-runtime.mjs",
    "src/local-transactions.mjs",
    "src/local-records.mjs",
    "src/local-courier.mjs",
    "src/native-storage.mjs",
    "src/material-sources.mjs",
    "src/stage1-facts.mjs",
    "src/safety-capabilities.mjs",
    "src/region-io.mjs",
    "src/region-batches.mjs",
    "src/flat-world.mjs",
    "src/local-world-deletion.mjs",
    "payload/hanaworlds_adapter/mod.conf",
    "payload/hanaworlds_adapter/init.lua",
    "payload/hanaworlds_adapter/engine.lua",
    "payload/hanaworlds_adapter/transport.lua",
    "payload/hanaworlds_adapter/region.lua",
    "payload/hanaworlds_adapter/facts.lua",
    "payload/hanaworlds_adapter/voxel.lua",
    "cordis.patch.yml",
    "GADGET.md",
    "LICENSE_AUDIT.md",
    "NOTICE",
    "DEFERRED-LOCAL-WORLD.md",
    "src/world-retirement.mjs",
    "src/host.mjs",
    "src/host.d.ts",
    "src/inspection-context.mjs",
    "src/inspection-context.d.ts"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/version.mjs && node --check src/local-worlds.mjs && node --check src/local-world-port.mjs && node --check src/local-runtime.mjs && node --check src/local-transactions.mjs && node --check src/local-records.mjs && node --check src/local-courier.mjs && node --check src/native-storage.mjs && node --check src/material-sources.mjs && node --check src/stage1-facts.mjs && node --check src/safety-capabilities.mjs && node --check src/region-io.mjs && node --check src/region-batches.mjs && node --check src/flat-world.mjs && node --check src/world-retirement.mjs && node --check src/local-world-deletion.mjs && luac -p payload/hanaworlds_adapter/init.lua payload/hanaworlds_adapter/engine.lua payload/hanaworlds_adapter/transport.lua payload/hanaworlds_adapter/region.lua payload/hanaworlds_adapter/facts.lua payload/hanaworlds_adapter/voxel.lua",
    "test": "node --test test/local-world-current.test.mjs test/local-world-v6.test.mjs",
    "test:lua": "lua test/local-world-region.lua && lua test/engine-guards.lua",
    "verify:contracts": "node scripts/verify-contracts-range.mjs",
    "test:catalogue": "node --test test/local-catalogue.test.mjs",
    "test:region": "node --test test/local-region-io.test.mjs",
    "test:flat": "node --test test/local-flat-world.test.mjs",
    "test:materials": "node --test test/local-material-facts.test.mjs test/local-material-sources.test.mjs",
    "test:switch": "node --test test/local-world-switch.test.mjs",
    "test:delete": "node --test test/local-world-delete.test.mjs",
    "test:readback": "node --test test/local-region-state.test.mjs test/world-readback-surface.test.mjs",
    "test:world-manage": "node --test test/world-manage.test.mjs test/world-manage-client.test.mjs test/local-world-switch.test.mjs",
    "test:contracts": "node --test test/contracts-dependency.test.mjs test/local-contract-handshake.test.mjs",
    "test:public-host": "node --test test/public-host-exports.test.mjs",
    "test:stage1": "node --test test/stage1-facts.test.mjs && lua test/stage1-facts.lua",
    "test:config-facts": "node --test test/config-engine-facts-contracts.test.mjs",
    "test:guards": "lua test/engine-guards.lua && node --test test/engine-guards-host.test.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "hanaworlds-contracts": "git+https://github.com/yzsnstotz/hanaworlds-contracts.git#semver:^2.0.0-rc.1"
  }
}
