{
  "name": "hanaworlds-adapter-luanti",
  "version": "0.7.5",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "HanaWorlds local-world world-adapter/v6; current connection and Canvas-only transaction transport",
  "repository": {
    "type": "git",
    "url": "https://github.com/yzsnstotz/hanaworlds-adapter-luanti.git"
  },
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "exports": {
    ".": "./src/index.mjs"
  },
  "imports": {
    "#contracts": "hanaworlds-contracts"
  },
  "files": [
    "src/index.mjs",
    "src/version.mjs",
    "src/local-worlds.mjs",
    "src/local-world-port.mjs",
    "src/local-runtime.mjs",
    "src/local-transactions.mjs",
    "src/local-records.mjs",
    "src/local-courier.mjs",
    "src/native-storage.mjs",
    "src/material-sources.mjs",
    "src/region-io.mjs",
    "src/region-batches.mjs",
    "src/flat-world.mjs",
    "src/local-world-deletion.mjs",
    "payload/hanaworlds_adapter/mod.conf",
    "payload/hanaworlds_adapter/init.lua",
    "payload/hanaworlds_adapter/engine.lua",
    "payload/hanaworlds_adapter/transport.lua",
    "payload/hanaworlds_adapter/region.lua",
    "payload/hanaworlds_adapter/facts.lua",
    "payload/hanaworlds_adapter/voxel.lua",
    "cordis.patch.yml",
    "GADGET.md",
    "LICENSE_AUDIT.md",
    "NOTICE",
    "DEFERRED-LOCAL-WORLD.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node --check src/index.mjs && node --check src/version.mjs && node --check src/local-worlds.mjs && node --check src/local-world-port.mjs && node --check src/local-runtime.mjs && node --check src/local-transactions.mjs && node --check src/local-records.mjs && node --check src/local-courier.mjs && node --check src/native-storage.mjs && node --check src/material-sources.mjs && node --check src/region-io.mjs && node --check src/region-batches.mjs && node --check src/flat-world.mjs && node --check src/local-world-deletion.mjs && luac -p payload/hanaworlds_adapter/init.lua payload/hanaworlds_adapter/engine.lua payload/hanaworlds_adapter/transport.lua payload/hanaworlds_adapter/region.lua payload/hanaworlds_adapter/facts.lua payload/hanaworlds_adapter/voxel.lua",
    "test": "node --test test/local-world-current.test.mjs test/local-world-v6.test.mjs",
    "test:lua": "lua test/local-world-region.lua",
    "verify:contracts": "node scripts/verify-contracts-pin.mjs",
    "verify:contracts:source": "node scripts/verify-contracts-pin.mjs --source",
    "test:catalogue": "node --test test/local-catalogue.test.mjs",
    "test:region": "node --test test/local-region-io.test.mjs",
    "test:flat": "node --test test/local-flat-world.test.mjs",
    "test:materials": "node --test test/local-material-facts.test.mjs test/local-material-sources.test.mjs",
    "test:switch": "node --test test/local-world-switch.test.mjs",
    "test:delete": "node --test test/local-world-delete.test.mjs",
    "test:readback": "node --test test/local-region-state.test.mjs test/world-readback-surface.test.mjs",
    "test:world-manage": "node --test test/world-manage.test.mjs test/world-manage-client.test.mjs test/local-world-switch.test.mjs",
    "test:contracts": "node --test test/contracts-dependency.test.mjs test/local-contract-handshake.test.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "hanaworlds-contracts": "https://codeload.github.com/yzsnstotz/hanaworlds-contracts/tar.gz/refs/tags/v0.5.3"
  }
}
