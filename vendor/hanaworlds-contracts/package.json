{
  "name": "hanaworlds-contracts",
  "version": "0.4.0",
  "description": "Pure current-local-world contracts. Fresh state only; strict decoding, business correlation, Canvas transactions and same-transaction history.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./types/local/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/local/index.d.ts",
      "import": "./dist/local/index.mjs"
    },
    "./schema": "./schemas/local/contracts.schema.json",
    "./profile": "./schemas/local/profile.json",
    "./fixtures/*": "./fixtures/local/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/local/",
    "dist/errors.mjs",
    "dist/geometry.mjs",
    "dist/strict-json.mjs",
    "dist/names.mjs",
    "types/local/",
    "schemas/local/",
    "fixtures/local/",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node tools/build-local.mjs",
    "test": "node test/local-world.mjs",
    "typecheck": "tsc --project consumer/local/tsconfig.json",
    "verify:source": "node tools/verify-local.mjs"
  },
  "dependencies": {
    "canonicalize": "5.1.0"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
